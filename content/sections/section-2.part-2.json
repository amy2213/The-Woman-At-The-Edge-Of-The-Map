{"section_id":"section-2","part":2,"part_count":2,"pieces":[{"id":"piece-025","title":"How to Bury a Version of Yourself","order":6,"global_order":25,"format":"poem","source":{"page_start":42,"page_end":42,"normalized_sha256":"15a007983da41d21a8b0f0bd696123eeb970c7bb8d40a85509b1a122d2ff4a95"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Step one:"}]},{"runs":[{"text":"Find a quiet place."}]},{"runs":[{"text":"Not peaceful, but quiet."}]},{"runs":[{"text":"You can feel the difference."}]},{"runs":[{"text":"Step two:"}]},{"runs":[{"text":"Bring what\u2019s left of her."}]},{"runs":[{"text":"The version who said yes too much."}]},{"runs":[{"text":"The one who apologized before speaking."}]},{"runs":[{"text":"Step three:"}]},{"runs":[{"text":"Dig deep."}]},{"runs":[{"text":"Deeper."}]},{"runs":[{"text":"Not into the dirt."}]},{"runs":[{"text":"Into your own bones."}]},{"runs":[{"text":"Make space where the shame lives rent-free."}]},{"runs":[{"text":"Step four:"}]},{"runs":[{"text":"Leave no marker."}]},{"runs":[{"text":"No flowers."}]},{"runs":[{"text":"No poems."}]},{"runs":[{"text":"That bitch had her chance."}]},{"runs":[{"text":"You\u2019ve got things to do now."}]}]}],"slug":"how-to-bury-a-version-of-yourself","previous_id":"piece-024","next_id":"piece-026"},{"id":"piece-026","title":"Confession Booth Burned Down","order":7,"global_order":26,"format":"poem","source":{"page_start":43,"page_end":43,"normalized_sha256":"5b3df9747bad43d242c8fc00032ae9ebb78cf525a5401009b72b6774a10c9863"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I tried to repent,"}]},{"runs":[{"text":"but the booth was on fire,"}]},{"runs":[{"text":"and the priest was high."}]},{"runs":[{"text":"So, I sat on the curb,"}]},{"runs":[{"text":"lit a smoke,"}]},{"runs":[{"text":"and told my sins to a rat,"}]},{"runs":[{"text":"who looked like he\u2019d heard worse."}]},{"runs":[{"text":"Forgive me,"}]},{"runs":[{"text":"for I have survived."}]},{"runs":[{"text":"I\u2019ve weaponized silence."}]},{"runs":[{"text":"I\u2019ve lied just to hear myself sound strong."}]},{"runs":[{"text":"I\u2019ve ghosted people I love"}]},{"runs":[{"text":"because I didn\u2019t want them"}]},{"runs":[{"text":"to see me choke."}]},{"runs":[{"text":"No Hail Marys."}]},{"runs":[{"text":"No clean slate."}]},{"runs":[{"text":"Just grit in my teeth"}]},{"runs":[{"text":"and a middle finger"}]},{"runs":[{"text":"aimed at the sky."}]}]}],"slug":"confession-booth-burned-down","previous_id":"piece-025","next_id":"piece-027"},{"id":"piece-027","title":"Operation: Mind Palace","order":8,"global_order":27,"format":"poem","source":{"page_start":44,"page_end":44,"normalized_sha256":"4a7990b3370730526832f19910e49db80b3d4c2aff378b253bce391fa6ad65d9"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I dreamed of a courtroom last night."}]},{"runs":[{"text":"The judge had no mouth."}]},{"runs":[{"text":"My lawyer was a different me"}]},{"runs":[{"text":"that still believed in redemption."}]},{"runs":[{"text":"I lost the case."}]},{"runs":[{"text":"Sentence: Continue existing without clarity."}]},{"runs":[{"text":"Woke up with my jaw locked again"}]},{"runs":[{"text":"and the sound of a gavel still ringing."}]},{"runs":[{"text":"I think the fog is thickening."}]}]}],"slug":"operation-mind-palace","previous_id":"piece-026","next_id":"piece-028"},{"id":"piece-028","title":"Autopsy Report (Living Subject)","order":9,"global_order":28,"format":"poem","source":{"page_start":45,"page_end":45,"normalized_sha256":"1365bc26e20c71745ef855f6017a13352c143aa282d9724765f498613ee4ec80"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Name: [Redacted]"}]},{"runs":[{"text":"Time of Death: Not yet"}]},{"runs":[{"text":"Cause: Repetition"}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Findings:"}]},{"runs":[{"text":"Heart\u2014calloused."}]},{"runs":[{"text":"Lungs\u2014half full of secrets."}]},{"runs":[{"text":"Tongue\u2014bitten through."}]},{"runs":[{"text":"Brain shows evidence"}]},{"runs":[{"text":"of overthinking,"}]},{"runs":[{"text":"gaslighting residue,"}]},{"runs":[{"text":"and long-term exposure"}]},{"runs":[{"text":"to betrayal."}]},{"runs":[{"text":"Soul: Unclaimed."}]},{"runs":[{"text":"Filed under \u201cToo Much.\u201d"}]},{"runs":[{"text":"Marked for incineration"}]},{"runs":[{"text":"by mistake."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Final note:"}]},{"runs":[{"text":"Subject kept walking."}]},{"runs":[{"text":"No logical explanation."}]},{"runs":[{"text":"The bitch just refused to die"}]},{"runs":[{"text":"despite everything"}]},{"runs":[{"text":"that said she should."}]}]}],"slug":"autopsy-report-living-subject","previous_id":"piece-027","next_id":"piece-029"},{"id":"piece-029","title":"The One I Keep in the Basement","order":10,"global_order":29,"format":"poem","source":{"page_start":46,"page_end":46,"normalized_sha256":"ef03a8ae77114891dca8861565d9747d0e0c2ba912a69039b23f0e58137c907d"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"She has blood on her dress"}]},{"runs":[{"text":"and fried chicken under her nails."}]},{"runs":[{"text":"She rolls her eyes"}]},{"runs":[{"text":"at my affirmations"}]},{"runs":[{"text":"and smokes the pages"}]},{"runs":[{"text":"of my self-help books."}]},{"runs":[{"text":"She doesn\u2019t want healing."}]},{"runs":[{"text":"She wants war."}]},{"runs":[{"text":"She wants honesty."}]},{"runs":[{"text":"I tried to bury her"}]},{"runs":[{"text":"in polite words,"}]},{"runs":[{"text":"in new jobs,"}]},{"runs":[{"text":"in better friends."}]},{"runs":[{"text":"But she wouldn\u2019t die."}]},{"runs":[{"text":"She waited."}]},{"runs":[{"text":"She watched."}]},{"runs":[{"text":"And when my life cracked open"}]},{"runs":[{"text":"she laughed so hard."}]},{"runs":[{"text":"Now I let her speak."}]},{"runs":[{"text":"Not all the time."}]},{"runs":[{"text":"But when things get too quiet"}]},{"runs":[{"text":"and my voice gets fake"}]},{"runs":[{"text":"and my spine starts bending,"}]},{"runs":[{"text":"I call her back up to the stage."}]},{"runs":[{"text":"She says the thing no one will."}]},{"runs":[{"text":"She breaks the rules I made for my own survival."}]},{"runs":[{"text":"She is chaos and clearance in one breath."}]},{"runs":[{"text":"I don\u2019t hate her anymore."}]},{"runs":[{"text":"I thank her."}]},{"runs":[{"text":"Because every time I forget who I am,"}]},{"runs":[{"text":"she reminds me who I was"}]},{"runs":[{"text":"before the world tried to fix me."}]}]}],"slug":"the-one-i-keep-in-the-basement","previous_id":"piece-028","next_id":"piece-030"}]}
