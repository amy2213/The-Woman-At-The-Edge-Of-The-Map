{"section_id":"section-1","part":2,"part_count":3,"pieces":[{"id":"piece-007","title":"The Cost of Passing while Masking","slug":"the-cost-of-passing-while-masking","order":7,"global_order":7,"format":"poem","source":{"page_start":21,"page_end":21,"normalized_sha256":"29e60ae23e013002d00020d35414b5d18f4abc82cf5598cd705c330e692d64fc"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Passing looks cheap. It is not."}]},{"runs":[{"text":"I pay in sleep, pain, and missed signals."}]},{"runs":[{"text":"Headphones: $199. Recovery after crowds: two hours."}]},{"runs":[{"text":"Smiles rented. Stomach clenched. Inbox delayed."}]},{"runs":[{"text":"Friends think I am fine."}]},{"runs":[{"text":"They see the mask, not the invoice."}]},{"runs":[{"text":"Real cost "},{"text":"is momentum"},{"text":" lost."}]},{"runs":[{"text":"Cheaper to tell the truth."}]},{"runs":[{"text":"I keep the money and my nervous system."}]}]}],"previous_id":"piece-006","next_id":"piece-008"},{"id":"piece-008","title":"Stolen Outfit","slug":"stolen-outfit","order":8,"global_order":8,"format":"poem","source":{"page_start":22,"page_end":22,"normalized_sha256":"efa0d597f557ad6dbd707dcb7ac9e99e061930da697dc9f5281932bec8d0fbba"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"She complimented me on my shirt."}]},{"runs":[{"text":"I said thank you,"}]},{"runs":[{"text":"but what I meant was:"}]},{"runs":[{"text":"I wore this because I’m falling apart"}]},{"runs":[{"text":"and needed something that didn’t."}]},{"runs":[{"text":"There’s still mascara on the collar"}]},{"runs":[{"text":"from a night"}]},{"runs":[{"text":"I don’t talk about."}]},{"runs":[{"text":"It wasn’t a fashion choice, lady."}]},{"runs":[{"text":"It was a flotation device."}]},{"runs":[{"text":"But hey, yeah,"}]},{"runs":[{"text":"glad you like the color."}]}]}],"previous_id":"piece-007","next_id":"piece-009"},{"id":"piece-009","title":"Errata","slug":"errata","order":9,"global_order":9,"format":"poem","source":{"page_start":23,"page_end":23,"normalized_sha256":"cc8b6865ee7afa789338c137ce05659ecda00532e769bd705c2b1dd9d6dfda83"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"“Manipulative” meant masking."}]},{"runs":[{"text":"“Lazy” meant depleted."}]},{"runs":[{"text":"“Defiant” meant overloaded."}]},{"runs":[{"text":"“Too much” meant unfiltered."}]},{"runs":[{"text":"Correction accepted."}]},{"runs":[{"text":"Choose rooms that let you."}]}]}],"previous_id":"piece-008","next_id":"piece-010"},{"id":"piece-010","title":"Curbside Confession","slug":"curbside-confession","order":10,"global_order":10,"format":"poem","source":{"page_start":24,"page_end":24,"normalized_sha256":"6c6110cbfc6531b1d5df57a3e7a435f8455f0ac9d61a1474a960645fe223f444"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I once baptized myself"}]},{"runs":[{"text":"in a gas station sink,"}]},{"runs":[{"text":"thinking maybe the soap scum"}]},{"runs":[{"text":"could erase what the priest didn’t."}]},{"runs":[{"text":"They say grace is free,"}]},{"runs":[{"text":"but mine came with a receipt"}]},{"runs":[{"text":"and a bag of Funyuns"}]},{"runs":[{"text":"on a Thursday,"}]},{"runs":[{"text":"when I finally told the truth"}]},{"runs":[{"text":"to a stranger who didn’t bat an eye."}]},{"runs":[{"text":"He just nodded,"}]},{"runs":[{"text":"took a swig of his grape soda,"}]},{"runs":[{"text":"and said,"}]},{"runs":[{"text":"“Yeah, me too.”"}]},{"runs":[{"text":"That was the closest thing to salvation"}]},{"runs":[{"text":"I’ve ever known."}]}]}],"previous_id":"piece-009","next_id":"piece-011"},{"id":"piece-011","title":"Leftover Fire","slug":"leftover-fire","order":11,"global_order":11,"format":"poem","source":{"page_start":25,"page_end":25,"normalized_sha256":"ea7672cca0b25299bd50d9b5159f73f395c079855a35691c12299fcee09f7f27"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"They told me I had lightning in me,"}]},{"runs":[{"text":"I spent years"}]},{"runs":[{"text":"trying to smother my sparks"}]},{"runs":[{"text":"so I wouldn’t burn the furniture."}]},{"runs":[{"text":"I found out"}]},{"runs":[{"text":"some houses deserve to burn."}]},{"runs":[{"text":"I used to fold myself so quiet,"}]},{"runs":[{"text":"like a napkin at someone else’s dinner."}]},{"runs":[{"text":"Now I talk back to mirrors"}]},{"runs":[{"text":"and mean it."}]},{"runs":[{"text":"I don’t need applause."}]},{"runs":[{"text":"I don’t want followers."}]},{"runs":[{"text":"Just give me a match,"}]},{"runs":[{"text":"an open road,"}]},{"runs":[{"text":"and the kind of silence"}]},{"runs":[{"text":"that feels like peace"}]},{"runs":[{"text":"instead of punishment."}]}]}],"previous_id":"piece-010","next_id":"piece-012"},{"id":"piece-012","title":"Abilene","slug":"abilene","order":12,"global_order":12,"format":"poem","source":{"page_start":26,"page_end":26,"normalized_sha256":"a08239cea57ed6d690d152d665700c31e12d3e30cff067962a627aee9c249bc4"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I was 14 my mornings smelled of freshly baked bread,"}]},{"runs":[{"text":"the warm comfort of the factory just outside."}]},{"runs":[{"text":"Evenings smelled of fire, smoke, despair—"}]},{"runs":[{"text":"the institution itself, a burning hell"}]},{"runs":[{"text":"I walked through every day."}]},{"runs":[{"text":"Then came Delinda,"}]},{"runs":[{"text":"her voice soft but steady,"}]},{"runs":[{"text":"her presence a light cutting through smoke and mirrors."}]},{"runs":[{"text":"She spoke of God like it was oxygen,"}]},{"runs":[{"text":"and somehow, she made the placement home listen."}]},{"runs":[{"text":"I went to church with her,"}]},{"runs":[{"text":"I sat under her words,"}]},{"runs":[{"text":"and felt something inside me shift."}]},{"runs":[{"text":"She baptized me,"}]},{"runs":[{"text":"and I was her first."}]},{"runs":[{"text":"In that water, in her hands,"}]},{"runs":[{"text":"I found a path I didn’t know was needed,"}]},{"runs":[{"text":"a lifeline, a salvation."}]},{"runs":[{"text":"Delinda wasn’t just a teacher—"}]},{"runs":[{"text":"she was the beginning of a world"}]},{"runs":[{"text":"I thought I’d never be welcome in."}]}]}],"previous_id":"piece-011","next_id":"piece-013"},{"id":"piece-013","title":"I Am Not a Metaphor","slug":"i-am-not-a-metaphor","order":13,"global_order":13,"format":"poem","source":{"page_start":27,"page_end":27,"normalized_sha256":"bcdbb0cb131f2d53bc42c74ab33aa10d419248f0c9d1d717a3ea02d066b15ccb"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Don’t call me a phoenix."}]},{"runs":[{"text":"Don’t say I rose."}]},{"runs":[{"text":"I limped."}]},{"runs":[{"text":"I cussed."}]},{"runs":[{"text":"I filed forms and forgot passwords."}]},{"runs":[{"text":"I sat on the floor of Walgreens"}]},{"runs":[{"text":"and cried in the vitamin aisle."}]},{"runs":[{"text":"There were no flames."}]},{"runs":[{"text":"No feathers."}]},{"runs":[{"text":"Just debt"}]},{"runs":[{"text":"and unresolved dental work"}]},{"runs":[{"text":"and a half-defrosted chicken"}]},{"runs":[{"text":"on the counter."}]},{"runs":[{"text":"I didn’t transform."}]},{"runs":[{"text":"I just didn’t die."}]},{"runs":[{"text":"That’s all."}]}]}],"previous_id":"piece-012","next_id":"piece-014"}]}