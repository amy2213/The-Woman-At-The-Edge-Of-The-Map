{"section_id":"section-3","part":2,"part_count":3,"pieces":[{"id":"piece-036","title":"What You Don\u2019t Say Still Counts","order":7,"global_order":36,"format":"poem","source":{"page_start":55,"page_end":55,"normalized_sha256":"c6f1b6ffe32491698ed8c3d93049b6738e33f02a113aba3db7031320ca3d77b4"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"You never hit me. That\u2019s true. "}]},{"runs":[{"text":"But you didn\u2019t need to. "}]},{"runs":[{"text":"You rolled your eyes  "}]},{"runs":[{"text":"when I cried. "}]},{"runs":[{"text":"You shut the door after gaslighting me "}]},{"runs":[{"text":"when I needed the truth. "}]},{"runs":[{"text":"You asked me to shrink and disappear  "}]},{"runs":[{"text":"then you blamed me  "}]},{"runs":[{"text":"for not being visible for the world to see."}]},{"runs":[{"text":"You told half-truths full of deception"}]},{"runs":[{"text":"so you could still say  "}]},{"runs":[{"text":"\u201cI didn\u2019t lie.\u201d  "}]},{"runs":[{"text":"But omission is architecture. "}]},{"runs":[{"text":"It builds just as much  "}]},{"runs":[{"text":"as honesty ever could. "}]},{"runs":[{"text":"Except colder. "}]},{"runs":[{"text":"With a sharper sting. "}]},{"runs":[{"text":"You don\u2019t get to say  "}]},{"runs":[{"text":"you didn\u2019t know. "}]},{"runs":[{"text":"You watched. "}]},{"runs":[{"text":"And your silence,  "}]},{"runs":[{"text":"that was a decision too."}]}]}],"slug":"what-you-don-t-say-still-counts","previous_id":"piece-035","next_id":"piece-037"},{"id":"piece-037","title":"Inventory Night","order":8,"global_order":37,"format":"poem","source":{"page_start":56,"page_end":56,"normalized_sha256":"9fef352b37019b414fc1ae371984739b883d6cb8226572d0be66128c620b63b8"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Five forks,"}]},{"runs":[{"text":"three chipped mugs,"}]},{"runs":[{"text":"a book I hate but will never return,"}]},{"runs":[{"text":"a grocery list written in a mood"}]},{"runs":[{"text":"I no longer feel."}]},{"runs":[{"text":"Half a candle?"}]},{"runs":[{"text":"An unopened envelope."}]},{"runs":[{"text":"A drawer full of spare keys"}]},{"runs":[{"text":"for doors that don\u2019t exist anymore."}]},{"runs":[{"text":"I live here, allegedly."}]},{"runs":[{"text":"But sometimes I catch myself "}]},{"runs":[{"text":"reaching for a light switch"}]},{"runs":[{"text":"that was never installed."}]}]}],"slug":"inventory-night","previous_id":"piece-036","next_id":"piece-038"},{"id":"piece-038","title":"Anyways, the Dishes","order":9,"global_order":38,"format":"poem","source":{"page_start":57,"page_end":57,"normalized_sha256":"7d0466f61f3f9a3db0efad03e592e98e71057f8c474b9f8338c8504fe526c209"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"One night you were telling me about your mother  "}]},{"runs":[{"text":"and I was thinking about the dishes  "}]},{"runs":[{"text":"in the sink. "}]},{"runs":[{"text":"Not because I didn\u2019t care. "}]},{"runs":[{"text":"But because I did. "}]},{"runs":[{"text":"And I knew that  "}]},{"runs":[{"text":"if I looked at you too long  "}]},{"runs":[{"text":"I would start crying  "}]},{"runs":[{"text":"about things that weren\u2019t yours. "}]},{"runs":[{"text":"So I stared at a dirty spoon. "}]},{"runs":[{"text":"And you kept talking. "}]},{"runs":[{"text":"And we were both kind of right."}]}]}],"slug":"anyways-the-dishes","previous_id":"piece-037","next_id":"piece-039"},{"id":"piece-039","title":"Belle of the Pity Party","order":10,"global_order":39,"format":"poem","source":{"page_start":58,"page_end":58,"normalized_sha256":"9b69c0cab87a8f57bcebd7a6fa4ec0db38e1333131905fa1cf6eff595606e572"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I threw myself a pity party"}]},{"runs":[{"text":"invites in gold script, folded with care"}]},{"runs":[{"text":"to friends, to strangers, anyone"}]},{"runs":[{"text":"who might laugh, cry, or just appear."}]},{"runs":[{"text":"Cupcakes lined in neat little rows,"}]},{"runs":[{"text":"frosting swirled like soft despair."}]},{"runs":[{"text":"I poured drinks into glasses"}]},{"runs":[{"text":"that never clinked, never cheered."}]},{"runs":[{"text":"The room was full of memories long gone."}]},{"runs":[{"text":"The music played, but only my sighs danced."}]},{"runs":[{"text":"I talked to shadows, toasted the air,"}]},{"runs":[{"text":"laughed at my own solitude."}]},{"runs":[{"text":"I had hoped for footsteps, voices, warmth,"}]},{"runs":[{"text":"but the only RSVP"}]},{"runs":[{"text":"was the silence I baked into every bite."}]},{"runs":[{"text":"And yet there\u2019s a strange comfort here:"}]},{"runs":[{"text":"I am both host and guest,"}]},{"runs":[{"text":"a queen of empty chairs,"}]},{"runs":[{"text":"the sovereign of a party only I attend."}]}]}],"slug":"belle-of-the-pity-party","previous_id":"piece-038","next_id":"piece-040"},{"id":"piece-040","title":"Sudden Weather","order":11,"global_order":40,"format":"poem","source":{"page_start":59,"page_end":59,"normalized_sha256":"a43de7688636ad81eab95ad014789c9894d0a6a713b473500f0597700b5760eb"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"It didn\u2019t start with a fight. "}]},{"runs":[{"text":"It started with a can of soup. "}]},{"runs":[{"text":"You said it was too salty. "}]},{"runs":[{"text":"I said nothing as usual."}]},{"runs":[{"text":"But then I thought to myself."}]},{"runs":[{"text":"This is how a flood begins."}]},{"runs":[{"text":"Not in thunder."}]},{"runs":[{"text":"It starts in teaspoons."}]},{"runs":[{"text":"In the steady drip  "}]},{"runs":[{"text":"of one unspoken thing  "}]},{"runs":[{"text":"on top of another. "}]},{"runs":[{"text":"Until the ceiling caves in  "}]},{"runs":[{"text":"and you both pretend it was a surprise."}]}]}],"slug":"sudden-weather","previous_id":"piece-039","next_id":"piece-041"}]}
