{"section_id":"section-7","part":1,"part_count":1,"pieces":[{"id":"piece-092","title":"The Woman Who Stayed","slug":"the-woman-who-stayed","order":1,"global_order":92,"format":"poem","source":{"page_start":118,"page_end":118,"normalized_sha256":"7dbfce979ece75661acfbe8a65299b24643df75c901a1a997ceaa1c8ab450bd2"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I used to think survival meant leaving."}]},{"runs":[{"text":"Leaving the room."}]},{"runs":[{"text":"Leaving the story."}]},{"runs":[{"text":"Leaving myself."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I was good at exits."}]},{"runs":[{"text":"I could disappear mid-sentence, mid-year, mid-life."}]},{"runs":[{"text":"I could shed identities like snakeskin and call it evolution."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"But leaving is easy when you’ve been doing it since childhood."}]},{"runs":[{"text":"Staying on the other hand,"}]},{"runs":[{"text":"that’s the revolution."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"The woman I am now didn’t arrive with fanfare."}]},{"runs":[{"text":"She didn’t rise from ashes or crawl out of any wreckage with a sword."}]},{"runs":[{"text":"She just… stayed."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"She stayed when the old panic flickered."}]},{"runs":[{"text":"She stayed when the urge to run hummed under her ribs."}]},{"runs":[{"text":"She "},{"text":"stayed when the story"},{"text":" quieted enough that she could finally hear her own voice without distortion."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"She stayed in the room long enough to notice that no one was coming to hurt her."}]},{"runs":[{"text":"She stayed in her body long enough to realize it wasn’t a battlefield anymore."}]},{"runs":[{"text":"She stayed in her truth long enough to recognize it as home."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"The woman who stayed is not the girl in the bathtub."}]},{"runs":[{"text":"Not the teenager with the lighter."}]},{"runs":[{"text":"Not the inmate counting days."}]},{"runs":[{"text":"Not the mythic creature in the files."}]},{"runs":[{"text":"Not the ghost who kept rehearsing her own disappearance."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"She is the one who lived through all of them"}]},{"runs":[{"text":"and didn’t abandon the wreckage."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"She stayed to clean it."}]},{"runs":[{"text":"She stayed to name it."}]},{"runs":[{"text":"She stayed to build something that didn’t require her to fracture herself to fit."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"She stayed because she finally understood:"}]},{"runs":[{"text":"leaving was survival,"}]},{"runs":[{"text":"but staying is sovereignty."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"And maybe that’s the whole point."}]},{"runs":[{"text":"Not the triumph."}]},{"runs":[{"text":"Not the redemption."}]},{"runs":[{"text":"Not the neat ending."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Just this:"}]}]},{"type":"stanza","lines":[{"runs":[{"text":"A woman who once believed she was made of exits now choosing, deliberately,"}]},{"runs":[{"text":"to remain."}]}]}],"previous_id":"piece-091","next_id":"piece-093"},{"id":"piece-093","title":"Terms of Engagement","slug":"terms-of-engagement","order":2,"global_order":93,"format":"poem","source":{"page_start":119,"page_end":120,"normalized_sha256":"0ff652b4e832067eb1bb95a5be1fb6af38802523f295cf772318970baffb3dcb"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I thought love meant endurance."}]},{"runs":[{"text":"Now I know it means clarity."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"So here are my terms, written without apology:"}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I don’t chase."}]},{"runs":[{"text":"I don’t beg."}]},{"runs":[{"text":"I don’t shrink to fit the room."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"If you want access to me,"}]},{"runs":[{"text":"bring honesty, not theatrics."}]},{"runs":[{"text":"Bring consistency, not chaos."}]},{"runs":[{"text":"Bring your whole self,"}]},{"runs":[{"text":"not the version you think I’ll applaud."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I’m not impressed by suffering anymore."}]},{"runs":[{"text":"I’ve seen enough of it to last three lifetimes."}]},{"runs":[{"text":"Show me your accountability instead."}]},{"runs":[{"text":"Show me your boundaries."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I don’t do half-truths."}]},{"runs":[{"text":"I don’t do emotional scavenger hunts."}]},{"runs":[{"text":"I don’t do relationships that require"}]},{"runs":[{"text":"a translator, a therapist,"}]},{"runs":[{"text":"and a fire extinguisher."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I am not a project."}]},{"runs":[{"text":"I am not a puzzle."}]},{"runs":[{"text":"I am not a prize for surviving your own damage."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I am a whole person"}]},{"runs":[{"text":"with a history that could level cities"}]},{"runs":[{"text":"and a heart that refuses to die."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"If you want to be here,"}]},{"runs":[{"text":"be here cleanly."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"If you don’t,"}]},{"runs":[{"text":"leave the door as you found it."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"These are my terms."}]},{"runs":[{"text":"Not because I’m hard to love,"}]},{"runs":[{"text":"but because I finally learned"}]},{"runs":[{"text":"how to love myself without witnesses."}]}]}],"previous_id":"piece-092","next_id":"piece-094"},{"id":"piece-094","title":"The Ordinary Miracle","slug":"the-ordinary-miracle","order":3,"global_order":94,"format":"poem","source":{"page_start":121,"page_end":124,"normalized_sha256":"177f741038606b1f3a09cc6febfc19b1b0ac25a738f082e5d293bfcfae06d03d"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I didn’t notice it for a long while."}]},{"runs":[{"text":"It was too small, too mundane, too easy to overlook."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"But one morning, I made coffee"}]},{"runs":[{"text":"and didn’t brace for anything."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"No dread."}]},{"runs":[{"text":"No scanning the room."}]},{"runs":[{"text":"No rehearsing conversations I’d never have."}]},{"runs":[{"text":"Just… coffee."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I stood there barefoot on a floor"}]},{"runs":[{"text":"that used to feel like a warning"}]},{"runs":[{"text":"and realized I wasn’t waiting for the day to turn on me."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"My miracle wasn’t joy."}]},{"runs":[{"text":"Heck it wasn’t peace."}]},{"runs":[{"text":"It wasn’t some cinematic breakthrough."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"It was the simple absence of fear."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"A quiet so steady"}]},{"runs":[{"text":"I almost mistook it for boredom."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I didn’t know life could feel like this"}]},{"runs":[{"text":"not triumphant, not tragic,"}]},{"runs":[{"text":"just gently mine."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I didn’t cry."}]},{"runs":[{"text":"I didn’t celebrate."}]},{"runs":[{"text":"I didn’t write it down."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I just took a sip"}]},{"runs":[{"text":"and let the warmth settle"}]},{"runs":[{"text":"in a body that finally believed"}]},{"runs":[{"text":"it was allowed to exist."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"That was the moment,"}]},{"runs":[{"text":"though I didn’t name it then."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"The moment I realized"}]},{"runs":[{"text":"I wasn’t surviving anymore."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I was living."}]}]}],"previous_id":"piece-093","next_id":null}]}