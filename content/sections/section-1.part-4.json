{"section_id":"section-1","part":4,"part_count":4,"pieces":[{"id":"piece-016","title":"Polite Doesn\u2019t Mean Safe","order":16,"global_order":16,"format":"poem","source":{"page_start":31,"page_end":31,"normalized_sha256":"a8692d5504a986873edd40dbbadf7e1dcbd4f8208a3533119b00af76f05d464a"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I smiled while you talked"}]},{"runs":[{"text":"because if I didn\u2019t,"}]},{"runs":[{"text":"you\u2019d say I was overreacting."}]},{"runs":[{"text":"Again."}]},{"runs":[{"text":"So yeah,"}]},{"runs":[{"text":"I smiled."}]},{"runs":[{"text":"And hated you."}]},{"runs":[{"text":"Quietly."}]},{"runs":[{"text":"Efficiently."}]},{"runs":[{"text":"With perfect posture."}]}]}],"slug":"polite-doesn-t-mean-safe","previous_id":"piece-015","next_id":"piece-017"},{"id":"piece-017","title":"Twice Without Warning","order":17,"global_order":17,"format":"poem","source":{"page_start":32,"page_end":33,"normalized_sha256":"715ecd79293a1a6627c8782ff8dcfbcbd0a341a87f05407ea15ddb6917e608a7"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"The first time, I was locked in a cell"}]},{"runs":[{"text":"cold, narrow, and heavy with the smell of bleach and metal."}]},{"runs":[{"text":"The woman at my door wasn\u2019t family or friend,"}]},{"runs":[{"text":"just someone who came from a church I\u2019d never been to,"}]},{"runs":[{"text":"offering a prayer I didn\u2019t think I needed."}]},{"runs":[{"text":"Her hand pressed to mine through the glass,"}]},{"runs":[{"text":"her voice steady and warm."}]},{"runs":[{"text":"And then my mouth betrayed me."}]},{"runs":[{"text":"Words I\u2019d never learned rushed out like a flood,"}]},{"runs":[{"text":"rolling over my tongue faster than thought could catch them."}]},{"runs":[{"text":"When it ended, I was drenched in sweat and tears,"}]},{"runs":[{"text":"unsure if something holy or something dangerous had just passed through me."}]},{"runs":[{"text":"She called it God."}]},{"runs":[{"text":"I wasn\u2019t so sure about that."}]},{"runs":[{"text":"The second time came a decade later,"}]},{"runs":[{"text":"in a quiet apartment in Irving."}]},{"runs":[{"text":"I was cleaning, alone,"}]},{"runs":[{"text":"when something told me to get on my knees."}]},{"runs":[{"text":"That wasn\u2019t me, I wasn\u2019t the kneeling type you see."}]},{"runs":[{"text":"But I did."}]},{"runs":[{"text":"And there it was again."}]},{"runs":[{"text":"That same river bursting through my ribs,"}]},{"runs":[{"text":"that same language older than memory."}]},{"runs":[{"text":"No preacher. No altar. No warning."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Just me,"}]},{"runs":[{"text":"the floor,"}]},{"runs":[{"text":"and a mystery"}]},{"runs":[{"text":"that refuses to leave me alone."}]}]}],"slug":"twice-without-warning","previous_id":"piece-016","next_id":"piece-018"},{"id":"piece-018","title":"Bad Day, No Poetic Twist","order":18,"global_order":18,"format":"poem","source":{"page_start":34,"page_end":34,"normalized_sha256":"9236e59aba98126a6b8f51654653fad99b1620c43e94b0f8cbe28370717381dd"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Today I lost a sock, a job lead, and my last ounce of performative optimism."}]},{"runs":[{"text":"Not in that order."}]},{"runs":[{"text":"The dryer ate one."}]},{"runs":[{"text":"The inbox ghosted me."}]},{"runs":[{"text":"And I ran out of \u201cIt\u2019s fine\u201ds somewhere between traffic and the grocery store where they moved the salami again."}]},{"runs":[{"text":"I know I\u2019m supposed to find the lesson."}]},{"runs":[{"text":"The growth."}]},{"runs":[{"text":"The poetic twist."}]},{"runs":[{"text":"But screw it."}]},{"runs":[{"text":"Some days aren\u2019t metaphors."}]},{"runs":[{"text":"They\u2019re just fucked up days with dull teeth"}]},{"runs":[{"text":"and a stale bagel"}]},{"runs":[{"text":"and a yawn that won\u2019t end."}]},{"runs":[{"text":"No epiphany. No breakthrough."}]},{"runs":[{"text":"Just more bills and a mild sunburn."}]},{"runs":[{"text":"And somehow,"}]},{"runs":[{"text":"that is all I need."}]}]}],"slug":"bad-day-no-poetic-twist","previous_id":"piece-017","next_id":"piece-019"},{"id":"piece-019","title":"Next Time, Just Say You Don\u2019t Know Me","order":19,"global_order":19,"format":"poem","source":{"page_start":35,"page_end":35,"normalized_sha256":"313131c8cca2048660335c955d90fc7e8eddac419fa8edbfa826c7af1b589988"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"You told someone I was \u201cresilient.\u201d"}]},{"runs":[{"text":"Like that\u2019s a compliment."}]},{"runs":[{"text":"No, dear, resilience is what people say"}]},{"runs":[{"text":"when they don\u2019t want to admit"}]},{"runs":[{"text":"they left you in the fire"}]},{"runs":[{"text":"and were surprised you came back"}]},{"runs":[{"text":"with only your eyebrows singed."}]}]}],"slug":"next-time-just-say-you-don-t-know-me","previous_id":"piece-018","next_id":"piece-020"}]}
