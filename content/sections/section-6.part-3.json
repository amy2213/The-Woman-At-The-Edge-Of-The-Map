{"section_id":"section-6","part":3,"part_count":3,"pieces":[{"id":"piece-091","title":"The Weight of Loving You","slug":"the-weight-of-loving-you","order":12,"global_order":91,"format":"poem","source":{"page_start":117,"page_end":117,"normalized_sha256":"4085de10129be53e14228942e3b376f71bacca37cbdbce5a9e2b1a8b159469c8"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Before you,"}]},{"runs":[{"text":"I thought love had conditions."}]},{"runs":[{"text":"I thought it was earned,"}]},{"runs":[{"text":"measured,"}]},{"runs":[{"text":"traded like something"}]},{"runs":[{"text":"that could be given or taken back."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Then you arrived,"}]},{"runs":[{"text":"and the rules I thought I knew"}]},{"runs":[{"text":"collapsed."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Loving you is not a choice I make;"}]},{"runs":[{"text":"it’s an instinct"}]},{"runs":[{"text":"woven into my blood."}]},{"runs":[{"text":"It’s the way my heart"}]},{"runs":[{"text":"beats faster when you laugh,"}]},{"runs":[{"text":"and how fear coils tight in my chest"}]},{"runs":[{"text":"at the thought of you hurting."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Unconditional love is beautiful,"}]},{"runs":[{"text":"but it’s not light."}]},{"runs":[{"text":"It’s the weight of the world"}]},{"runs":[{"text":"in the best and worst ways:"}]},{"runs":[{"text":"the knowledge that my soul"}]},{"runs":[{"text":"is stitched to yours,"}]},{"runs":[{"text":"and I would set fire to heaven and earth"}]},{"runs":[{"text":"to keep you safe."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"You are my proof"}]},{"runs":[{"text":"that love can be infinite,"}]},{"runs":[{"text":"and my reminder"}]},{"runs":[{"text":"that infinity is heavy to hold."}]}]}],"previous_id":"piece-090","next_id":"piece-092"}]}