{"section_id":"section-1","part":3,"part_count":4,"pieces":[{"id":"piece-011","title":"Leftover Fire","order":11,"global_order":11,"format":"poem","source":{"page_start":25,"page_end":25,"normalized_sha256":"ea7672cca0b25299bd50d9b5159f73f395c079855a35691c12299fcee09f7f27"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"They told me I had lightning in me,"}]},{"runs":[{"text":"I spent years"}]},{"runs":[{"text":"trying to smother my sparks"}]},{"runs":[{"text":"so I wouldn\u2019t burn the furniture."}]},{"runs":[{"text":"I found out"}]},{"runs":[{"text":"some houses deserve to burn."}]},{"runs":[{"text":"I used to fold myself so quiet,"}]},{"runs":[{"text":"like a napkin at someone else\u2019s dinner."}]},{"runs":[{"text":"Now I talk back to mirrors"}]},{"runs":[{"text":"and mean it."}]},{"runs":[{"text":"I don\u2019t need applause."}]},{"runs":[{"text":"I don\u2019t want followers."}]},{"runs":[{"text":"Just give me a match,"}]},{"runs":[{"text":"an open road,"}]},{"runs":[{"text":"and the kind of silence"}]},{"runs":[{"text":"that feels like peace"}]},{"runs":[{"text":"instead of punishment."}]}]}],"slug":"leftover-fire","previous_id":"piece-010","next_id":"piece-012"},{"id":"piece-012","title":"Abilene","order":12,"global_order":12,"format":"poem","source":{"page_start":26,"page_end":26,"normalized_sha256":"a08239cea57ed6d690d152d665700c31e12d3e30cff067962a627aee9c249bc4"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"I was 14 my mornings smelled of freshly baked bread,"}]},{"runs":[{"text":"the warm comfort of the factory just outside."}]},{"runs":[{"text":"Evenings smelled of fire, smoke, despair\u2014"}]},{"runs":[{"text":"the institution itself, a burning hell"}]},{"runs":[{"text":"I walked through every day."}]},{"runs":[{"text":"Then came Delinda,"}]},{"runs":[{"text":"her voice soft but steady,"}]},{"runs":[{"text":"her presence a light cutting through smoke and mirrors."}]},{"runs":[{"text":"She spoke of God like it was oxygen,"}]},{"runs":[{"text":"and somehow, she made the placement home listen."}]},{"runs":[{"text":"I went to church with her,"}]},{"runs":[{"text":"I sat under her words,"}]},{"runs":[{"text":"and felt something inside me shift."}]},{"runs":[{"text":"She baptized me,"}]},{"runs":[{"text":"and I was her first."}]},{"runs":[{"text":"In that water, in her hands,"}]},{"runs":[{"text":"I found a path I didn\u2019t know was needed,"}]},{"runs":[{"text":"a lifeline, a salvation."}]},{"runs":[{"text":"Delinda wasn\u2019t just a teacher\u2014"}]},{"runs":[{"text":"she was the beginning of a world"}]},{"runs":[{"text":"I thought I\u2019d never be welcome in."}]}]}],"slug":"abilene","previous_id":"piece-011","next_id":"piece-013"},{"id":"piece-013","title":"I Am Not a Metaphor","order":13,"global_order":13,"format":"poem","source":{"page_start":27,"page_end":27,"normalized_sha256":"bcdbb0cb131f2d53bc42c74ab33aa10d419248f0c9d1d717a3ea02d066b15ccb"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"Don\u2019t call me a phoenix."}]},{"runs":[{"text":"Don\u2019t say I rose."}]},{"runs":[{"text":"I limped."}]},{"runs":[{"text":"I cussed."}]},{"runs":[{"text":"I filed forms and forgot passwords."}]},{"runs":[{"text":"I sat on the floor of Walgreens"}]},{"runs":[{"text":"and cried in the vitamin aisle."}]},{"runs":[{"text":"There were no flames."}]},{"runs":[{"text":"No feathers."}]},{"runs":[{"text":"Just debt"}]},{"runs":[{"text":"and unresolved dental work"}]},{"runs":[{"text":"and a half-defrosted chicken"}]},{"runs":[{"text":"on the counter."}]},{"runs":[{"text":"I didn\u2019t transform."}]},{"runs":[{"text":"I just didn\u2019t die."}]},{"runs":[{"text":"That\u2019s all."}]}]}],"slug":"i-am-not-a-metaphor","previous_id":"piece-012","next_id":"piece-014"},{"id":"piece-014","title":"What I Was Given","order":14,"global_order":14,"format":"poem","source":{"page_start":28,"page_end":29,"normalized_sha256":"1d514ffee1e2c91e43385db1e9046396ba36be77df4410c5853a01d4c04a02f0"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"and what I took anyway","italic":true}]},{"runs":[{"text":"They never gave me a map."}]},{"runs":[{"text":"Instead they built a minefield."}]},{"runs":[{"text":"It was suggested I walk as if it was solid ground."}]},{"runs":[{"text":"I wasn\u2019t given peace."}]},{"runs":[{"text":"I was given people who mistook silence for comfort"}]},{"runs":[{"text":"and called my confusion a growth opportunity."}]},{"runs":[{"text":"I wasn\u2019t given mentors."}]},{"runs":[{"text":"I was given mirrors with smudges,"}]},{"runs":[{"text":"some cracked,"}]},{"runs":[{"text":"some angled just enough to see the trap"}]},{"runs":[{"text":"but not the way out."}]},{"runs":[{"text":"Still, somehow, I learned."}]},{"runs":[{"text":"I learned to read the tone before the words."}]},{"runs":[{"text":"Learned to carry five lives in one single body"}]},{"runs":[{"text":"and to answer the phone like none of them were breaking."}]},{"runs":[{"text":"They said I had grit."}]},{"runs":[{"text":"But grit is the name they give the pain"}]},{"runs":[{"text":"when they want you to carry the secret quietly."}]},{"runs":[{"text":"I call it inheritance."}]},{"runs":[{"text":"I call it alchemy."}]},{"runs":[{"text":"I call it the ability to take a half-buried truth,"}]},{"runs":[{"text":"pull it out, and form it into clarity."}]},{"runs":[{"text":"My blessings?"}]},{"runs":[{"text":"Sharp."}]},{"runs":[{"text":"Unsoft."}]},{"runs":[{"text":"Hard-won."}]},{"runs":[{"text":"These kinds of blessings"}]},{"runs":[{"text":"you don\u2019t post about on Facebook"}]},{"runs":[{"text":"because people wouldn\u2019t know how to swallow them."}]},{"runs":[{"text":"A blessing like:"}]},{"runs":[{"text":"No longer being fooled by kindness."}]},{"runs":[{"text":"A blessing like:"}]},{"runs":[{"text":"Knowing how to leave."}]},{"runs":[{"text":"A blessing like:"}]},{"runs":[{"text":"Building something real when everyone else is playing pretend."}]},{"runs":[{"text":"I was not given much."}]},{"runs":[{"text":"But I took everything I needed."}]},{"runs":[{"text":"And I left the rest burning"}]},{"runs":[{"text":"so no one else would have to crawl through it blind."}]}]}],"slug":"what-i-was-given","previous_id":"piece-013","next_id":"piece-015"},{"id":"piece-015","title":"Oh, You Meant Well?","order":15,"global_order":15,"format":"poem","source":{"page_start":30,"page_end":30,"normalized_sha256":"f2f02c2a7829e6d0f56eac2bedec894af301b436e9a97a0553051c03cec44965"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"And I meant not to cringe"}]},{"runs":[{"text":"when you told me how I could be better"}]},{"runs":[{"text":"if I just tried being less."}]},{"runs":[{"text":"Intentions don\u2019t cancel outcomes."}]},{"runs":[{"text":"Neither do emojis."}]}]}],"slug":"oh-you-meant-well","previous_id":"piece-014","next_id":"piece-016"}]}
