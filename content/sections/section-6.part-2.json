{"section_id":"section-6","part":2,"part_count":3,"pieces":[{"id":"piece-087","title":"To the Stranger Who Held the Door","slug":"to-the-stranger-who-held-the-door","order":8,"global_order":87,"format":"letter","source":{"page_start":112,"page_end":112,"normalized_sha256":"d6116e3ceb171ab8258a3cb4483101299f1273df518e3a159ee89cd7c5edc50e"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"You didn’t know it,"}]},{"runs":[{"text":"but I was unraveling"}]},{"runs":[{"text":"that day."}]},{"runs":[{"text":"You held the door"}]},{"runs":[{"text":"for half a second longer"}]},{"runs":[{"text":"than required."}]},{"runs":[{"text":"You nodded,"}]},{"runs":[{"text":"like I was real."}]},{"runs":[{"text":"Not scenery."}]},{"runs":[{"text":"Not a threat."}]},{"runs":[{"text":"Not invisible."}]},{"runs":[{"text":"It meant nothing to you."}]},{"runs":[{"text":"But it meant"}]},{"runs":[{"text":"everything"}]},{"runs":[{"text":"to me."}]},{"runs":[{"text":"It was the first human kindness"}]},{"runs":[{"text":"I’d felt in three weeks."}]},{"runs":[{"text":"You didn’t fix me."}]},{"runs":[{"text":"You didn’t even see me."}]},{"runs":[{"text":"But you held the door."}]},{"runs":[{"text":"And I walked through."}]},{"runs":[{"text":"And that was everything."}]}]}],"previous_id":"piece-086","next_id":"piece-088"},{"id":"piece-088","title":"To the Courts and Players","slug":"to-the-courts-and-players","order":9,"global_order":88,"format":"letter","source":{"page_start":113,"page_end":114,"normalized_sha256":"e0f44cfbb9eb0c9a9effc1b3092eafe6286c460fea36d216f4273311273a785f"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"There will be no apologies, no edits, no requests for confirmation."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Let the record show:"}]},{"runs":[{"text":"I was not informed."}]},{"runs":[{"text":"I was not trained."}]},{"runs":[{"text":"I was not protected."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I was given tasks with missing instructions"}]},{"runs":[{"text":"and consequences no one claimed."}]},{"runs":[{"text":"I performed beyond my capacity,"}]},{"runs":[{"text":"then I punished myself for falling short."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Let the record show:"}]},{"runs":[{"text":"I stayed long after the others left"}]},{"runs":[{"text":"because I knew how to read ruins."}]},{"runs":[{"text":"Because I believed,"}]},{"runs":[{"text":"foolishly, maybe, just maybe,"}]},{"runs":[{"text":"that doing it right could matter"}]},{"runs":[{"text":"even if no one was watching."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Except you were watching."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Don’t bother trying to deny it."}]},{"runs":[{"text":"Sudden opportunities."}]},{"runs":[{"text":"The quiet people with soft hands and too many answers."}]},{"runs":[{"text":"The men with charm and clearance."}]},{"runs":[{"text":"The ones who repeated my phrasing back to me"}]},{"runs":[{"text":"like training exercises."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"You were always watching."}]},{"runs":[{"text":"And you were wrong."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I didn’t break the way you predicted I might."}]},{"runs":[{"text":"I didn’t self-destruct."}]},{"runs":[{"text":"I evolved."}]},{"runs":[{"text":"I documented."}]},{"runs":[{"text":"I mapped the patterns and kept my receipts."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I played the game just long enough to rewrite it."}]},{"runs":[{"text":"And now I want to turn away."}]},{"runs":[{"text":"I want out, on my own terms."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Not with your fancy medals."}]},{"runs":[{"text":"Not with your secret mentorship."}]},{"runs":[{"text":"Not with your quiet offers of influence."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"With my name."}]},{"runs":[{"text":"With my hard work intact."}]},{"runs":[{"text":"With every system I built from scraps credited back to the hands that bled to make them."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"So file this if you must:"}]},{"runs":[{"text":"I was never a subject to be studied."}]},{"runs":[{"text":"I was never a phase."}]},{"runs":[{"text":"I am the architect amidst the wreckage,"}]},{"runs":[{"text":"drawing my own exits,"}]},{"runs":[{"text":"that you didn’t want anyone else to find."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Now they’re open."}]},{"runs":[{"text":"And I’m already gone."}]}]}],"previous_id":"piece-087","next_id":"piece-089"},{"id":"piece-089","title":"Irelyn","slug":"irelyn","order":10,"global_order":89,"format":"poem","source":{"page_start":115,"page_end":115,"normalized_sha256":"015486a86008bcbe35e80564776fe20dfd05c8ad05a29c3220df7d47a2ea6a19"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"You came into this world"}]},{"runs":[{"text":"small enough to fit"}]},{"runs":[{"text":"between my hands,"}]},{"runs":[{"text":"yet somehow large enough"}]},{"runs":[{"text":"to change the size of my soul."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Every choice I make"}]},{"runs":[{"text":"bends toward you,"}]},{"runs":[{"text":"like rivers toward the ocean,"}]},{"runs":[{"text":"like planets toward the sun."}]},{"runs":[{"text":"You are my compass,"}]},{"runs":[{"text":"my North,"}]},{"runs":[{"text":"the steady pull that keeps me moving"}]},{"runs":[{"text":"when everything else"}]},{"runs":[{"text":"feels like it’s breaking apart."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Your laughter is the sound"}]},{"runs":[{"text":"that stitches me back together."}]},{"runs":[{"text":"Your voice is the reason"}]},{"runs":[{"text":"I keep showing up,"}]},{"runs":[{"text":"even when I’m tired,"}]},{"runs":[{"text":"even when the world"}]},{"runs":[{"text":"feels heavier than I can carry."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"You don’t just give my life meaning;"}]},{"runs":[{"text":"you are the meaning."}]},{"runs":[{"text":"My reason for being"}]},{"runs":[{"text":"is spelled out in your name,"}]},{"runs":[{"text":"and every day,"}]},{"runs":[{"text":"I am grateful"}]},{"runs":[{"text":"that you are mine."}]}]}],"previous_id":"piece-088","next_id":"piece-090"},{"id":"piece-090","title":"Red Marker Day","slug":"red-marker-day","order":11,"global_order":90,"format":"poem","source":{"page_start":116,"page_end":116,"normalized_sha256":"9a01a1b7627d1622105f24a7f0e6c5df8799f3c5781bf14801006f4461e62ac5"},"blocks":[{"type":"stanza","lines":[{"runs":[{"text":"You were two,"}]},{"runs":[{"text":"maybe three,"}]},{"runs":[{"text":"and far too quiet in the other room."}]},{"runs":[{"text":"I should have known."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"When you came tearing around the corner,"}]},{"runs":[{"text":"diaper sagging,"}]},{"runs":[{"text":"smile wide enough to crack open the earth,"}]},{"runs":[{"text":"your whole body was painted"}]},{"runs":[{"text":"in streaks of red marker."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"Arms, legs, belly:"}]},{"runs":[{"text":"a masterpiece in motion."}]},{"runs":[{"text":"You didn’t walk,"}]},{"runs":[{"text":"you paraded,"}]},{"runs":[{"text":"like the world was finally seeing you"}]},{"runs":[{"text":"in your true colors."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I laughed so hard"}]},{"runs":[{"text":"I almost forgot"}]},{"runs":[{"text":"to pretend to be the responsible one."}]},{"runs":[{"text":"In that moment"}]},{"runs":[{"text":"you were pure joy,"}]},{"runs":[{"text":"pure mischief,"}]},{"runs":[{"text":"pure Irelyn."}]}]},{"type":"stanza","lines":[{"runs":[{"text":"I knew then"}]},{"runs":[{"text":"the messes,"}]},{"runs":[{"text":"the chaos,"}]},{"runs":[{"text":"the impossible clean up,"}]},{"runs":[{"text":"were worth every second"}]},{"runs":[{"text":"if it meant seeing you"}]},{"runs":[{"text":"that free."}]}]}],"previous_id":"piece-089","next_id":"piece-091"}]}